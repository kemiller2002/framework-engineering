{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EX-SCHEMA-1.0",
  "title": "Framework Engineering Experiment",
  "type": "object",
  "required": ["id", "title", "status", "version", "research_area", "lineage", "question", "hypothesis", "claim_under_test", "inputs", "procedure", "falsification_conditions", "providers", "result_schema"],
  "properties": {
    "id": { "type": "string", "pattern": "^EX-[A-Z0-9-]+$" },
    "status": { "enum": ["proposed", "ready", "running", "partially-complete", "complete", "blocked", "invalidated", "superseded"] },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" }
        }
      }
    }
  },
  "additionalProperties": true
}
