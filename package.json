{
  "scripts": {
    "postinstall": "node ./scripts/patch-research-publisher.mjs",
    "experiments": "node ./tools/experiments/experiments.mjs",
    "experiments:migrate": "node ./tools/experiments/migrate-historical.mjs",
    "experiments:test": "node --test ./tools/experiments/test/*.test.mjs",
    "experiments:verify": "node ./tools/experiments/experiments.mjs verify --all",
    "ros-fe:validate": "node ./tools/ros-fe-profile.mjs validate",
    "ros-fe:registry": "node ./tools/ros-fe-profile.mjs registry build",
    "ros-fe:test": "node --test ./tools/ros-fe-profile.test.mjs",
    "frontier:build": "node ./research/frontier/build-frontier.mjs",
    "frontier:check": "node ./research/frontier/build-frontier.mjs --check",
    "research:inventory": "research-publisher inventory --config ./research-publisher.config.mjs",
    "research:validate": "research-publisher validate --config ./research-publisher.config.mjs",
    "research:build": "research-publisher build --config ./research-publisher.config.mjs",
    "research:clean": "research-publisher clean --config ./research-publisher.config.mjs",
    "ui:conformance": "playwright test --config=playwright.ui-conformance.config.mjs && node tests/ui-conformance/validate-evidence.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "ajv": "8.17.1",
    "research-publisher": "github:kemiller2002/research-publisher#main"
  }
}
